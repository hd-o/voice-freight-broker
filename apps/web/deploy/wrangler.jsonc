{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "app",
  // Set the deployed account and PUBLIC_ORIGIN once during infrastructure setup.
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  // For a custom domain, set workers_dev to false and configure:
  // "routes": [{ "pattern": "freight.example.com", "custom_domain": true }],
  "main": "worker.ts",
  "vars": { "AUTH_MODE": "access", "PUBLIC_ORIGIN": "https://deployment.invalid" },
  "services": [{ "binding": "API", "service": "voice-freight-api" }],
  "env": { "local": { "vars": { "AUTH_MODE": "local" } } },
  "preview_urls": false,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/auth/*"],
    "not_found_handling": "404-page",
  },
}
