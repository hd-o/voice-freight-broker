{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "main": "worker.ts",
  "vars": {
    "AUTH_MODE": "local",
  },
  "env": {
    "local": {
      "vars": {
        "AUTH_MODE": "local",
      },
    },
  },
  "preview_urls": false,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/auth/*"],
    "not_found_handling": "404-page",
  },
}
