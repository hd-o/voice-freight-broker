{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voice-freight-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CALLS",
        "class_name": "LiveCall",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveCall"],
    },
  ],
  "env": {
    "local": {
      "name": "voice-freight-api",
      "vars": {
        "ENVIRONMENT": "local",
        "AUTH_MODE": "local",
        "VOICE_PROVIDER": "openai",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CALLS",
            "class_name": "LiveCall",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voice-freight-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/backend/migrations",
        },
      ],
      "services": [
        {
          "binding": "TOOLS",
          "service": "voice-freight-tools",
          "entrypoint": "Tools",
        },
      ],
    },
  },
}
