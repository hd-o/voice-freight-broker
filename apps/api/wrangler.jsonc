{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voice-freight-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "hosted",
    "AUTH_MODE": "access",
    "VOICE_PROVIDER": "openai",
  },
  "durable_objects": {
    "bindings": [{ "name": "CALLS", "class_name": "LiveCall" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveCall"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
  },
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "local": {
      "name": "voice-freight-api",
      "vars": {
        "ENVIRONMENT": "local",
        "AUTH_MODE": "local",
        "VOICE_PROVIDER": "openai",
      },
      "durable_objects": {
        "bindings": [{ "name": "CALLS", "class_name": "LiveCall" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voice-freight-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "../../packages/backend/migrations",
        },
      ],
      "services": [
        {
          "binding": "TOOLS",
          "service": "voice-freight-tools",
          "entrypoint": "Tools",
        },
      ],
    },
    "stub": {
      "name": "voice-freight-api-stub",
      "vars": {
        "ENVIRONMENT": "local",
        "AUTH_MODE": "local",
        "VOICE_PROVIDER": "stub",
        "VOICE_STUB_SCENARIO": "workflow",
      },
      "durable_objects": {
        "bindings": [{ "name": "CALLS", "class_name": "LiveCall" }],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voice-freight-stub",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "../../packages/backend/migrations",
        },
      ],
      "services": [
        {
          "binding": "TOOLS",
          "service": "voice-freight-tools-stub",
          "entrypoint": "Tools",
        },
      ],
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voice-freight-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/backend/migrations",
    },
  ],
  "services": [
    {
      "binding": "TOOLS",
      "service": "voice-freight-tools",
      "entrypoint": "Tools",
    },
  ],
}
