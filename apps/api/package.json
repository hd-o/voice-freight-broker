{
  "name": "@voice-freight/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env local --config wrangler.jsonc --config ../tools/wrangler.jsonc --port 8787 --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:test": "wrangler deploy --dry-run --env local --outdir dist-test",
    "cf:types": "wrangler types --config wrangler.jsonc --config ../tools/wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@voice-freight/backend": "workspace:*",
    "@voice-freight/contracts": "workspace:*",
    "@voice-freight/tools": "workspace:*",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "vitest": "5.1.0"
  }
}
