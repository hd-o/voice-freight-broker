{
	"$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/devcontainers/features/node:2": {}
	},
	"mounts": [
		"type=bind,src=/tmp,dst=/tmp"
	],
	"postCreateCommand": "bash scripts/setup.sh",
	"remoteEnv": {
		"VP_HOME": "/home/vscode/.vite-plus",
		"PATH": "/home/vscode/.vite-plus/bin:${containerEnv:PATH}:/home/vscode/.vite-plus/fallback-bin"
	},
	"forwardPorts": [3000, 6006, 8787],
	"portsAttributes": {
		"3000": { "label": "Vinext" },
		"6006": { "label": "Storybook" },
		"8787": { "label": "Workers API" }
	}
}
