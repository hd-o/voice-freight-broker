{
  "name": "voice-freight-broker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:storybook": "vpr @voice-freight/web#build:storybook",
    "build": "vpr -r build",
    "cf:types": "vpr @voice-freight/tools#cf:types && vpr @voice-freight/api#cf:types",
    "check": "vp check && vpr typecheck && markdownlint-cli2 README.md AGENTS.md infrastructure/README.md",
    "cli": "node packages/cli/src/index.ts",
    "db:generate": "vpr @voice-freight/backend#db:generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --env local --config apps/api/wrangler.jsonc --persist-to .wrangler/state",
    "deploy:prod": "bash scripts/deploy.sh",
    "deploy:roles": "pnpm --silent cli deployed roles sync",
    "deploy": "vpr deploy:prod",
    "dev:reset:limits": "pnpm --silent cli dev limits reset",
    "dev:web": "vpr @voice-freight/web#dev",
    "dev:workers": "vpr @voice-freight/api#dev",
    "dev": "vpr --parallel --filter @voice-freight/web --filter @voice-freight/api dev",
    "eval:help": "vpr eval --help",
    "eval:typecheck": "tsc --noEmit -p evals/tsconfig.json",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo view --port 15500",
    "eval": "pnpm --silent cli eval",
    "format": "vp fmt",
    "lint": "vp lint --fix",
    "prepare": "vp config --no-agent",
    "preview": "vpr @voice-freight/web#preview",
    "storybook": "vpr @voice-freight/web#storybook",
    "test:api": "vpr @voice-freight/tools#build && vpr @voice-freight/api#test",
    "test:browser": "playwright test",
    "test:cli": "vpr @voice-freight/cli#test",
    "test:eval": "PROMPTFOO_DISABLE_TELEMETRY=1 node --test evals/runtime.test.ts",
    "test": "vpr test:cli && vpr test:api",
    "typecheck": "tsc --noEmit && vpr eval:typecheck && vpr -r typecheck",
    "deploy:bootstrap": "bash scripts/deploy.sh --bootstrap"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.24.1",
    "miniflare": "5.20261110.2-beta",
    "playwright-core": "1.65.0",
    "promptfoo": "0.125.1",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "wrangler": "4.161.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.18.0"
}
